# Artefactos de compilación (regenerados por build.bat / test.bat / mvnw)
/out/
/out-main/
/out-test/
/unpack/
/tiendas-mass.jar
/target/
/dependency-reduced-pom.xml

# Base de datos local (se crea automáticamente en el primer arranque)
/tiendas_mass.db
/tiendas_mass.db.corrupto-*

# Reportes de la suite de tests (se regeneran en cada corrida de test.bat / mvnw test)
/test-reports/

# Logs de la aplicación (Taller de Monitoreo, ver MONITORING.md) - se generan en runtime
/logs/

# Backups locales (Taller de Mantenimiento, ver MAINTENANCE.md) - se generan en runtime
/backups/

# Reportes diarios de stock (scripts/reporte-stock-diario.bat) - se generan en runtime
/reportes/
